# Copy to .env in the repository root. Never commit .env or put keys in chat.
# Ask Davy uses Chat Completions on explicit submit in all four views.
# Strict schema is preferred; unsupported format responses can use validated JSON-object output.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Keep ingestion, action parsing, and briefs offline in the demo.
MISSIONTWIN_DEMO_MODE=1

# Shared assistant-only override (does not enable ingestion/actions/briefs).
# 1 = allow configured live generation on explicit submit; 0 = validated cache/fallback only.
# If omitted, inherit the application's live/demo state. Opening makes no model call.
LOCKER_DAVEY_LIVE=0
