# Copy to .env in the repository root. Never commit .env or put keys in chat.
# Ask Davey uses Chat Completions with strict JSON-schema output after a question is submitted.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Keep ingestion, action parsing, and briefs offline in the demo.
MISSIONTWIN_DEMO_MODE=1

# 1 = allow Ask Davey to use the server-side OpenAI key after explicit submit.
# 0 = cached responses or calculated fallback only. Opening the popup makes no model call.
LOCKER_DAVEY_LIVE=0
