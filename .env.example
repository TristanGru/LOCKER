# Copy to .env in the repository root. Never commit .env or put keys in chat.
# The endpoint must support /chat/completions and JSON-object responses.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# 0 = allow live model calls; 1 = disk cache only, never contact the endpoint.
# Keep the SAME LLM_MODEL when switching to offline replay.
MISSIONTWIN_DEMO_MODE=0
